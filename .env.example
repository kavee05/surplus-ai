# Copy to .env.local for local development. Never commit .env.local.
# In Vercel, set these under Settings > Environment Variables for BOTH
# Production and Preview, then redeploy. Full guide: docs/LIVE_AI_SETUP.md
# Demo mode is the default and needs nothing here.
# Surplus AI uses the Google Gemini API only.

# Turn live AI on. Accepts true, 1, yes or on.
LIVE_AI=false

# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Gemini model. Default: gemini-3.5-flash-lite (fast, multimodal, stable).
# Alternative: gemini-3.8-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# Global cap on live AI calls per day (default 200). Also set a spending
# or quota limit in Google AI Studio or Google Cloud.
LIVE_AI_DAILY_CAP=200

# Optional: Upstash Redis REST credentials, so the usage limits are shared
# across serverless instances. Without them, limits are per instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public URL, used for metadata and the sitemap
NEXT_PUBLIC_SITE_URL=https://surplus-ai.vercel.app
