# Copy to .env.local for local development. Never commit .env.local.
# In Vercel, set these under Settings > Environment Variables for BOTH
# Production and Preview, then redeploy.
# Demo mode is the default and needs nothing here.

# Turn live AI on. Accepts true, 1, yes or on.
LIVE_AI=false

# Which provider to use: gemini (default) or anthropic
LLM_PROVIDER=gemini

# Gemini (https://ai.google.dev). Default model: gemini-3.5-flash-lite
GEMINI_API_KEY=
GEMINI_MODEL=

# Anthropic (https://console.anthropic.com). Default model: claude-opus-5-5
# Set ANTHROPIC_MODEL=claude-haiku-5-5 for lower cost.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Global cap on live AI calls per day (default 200). Also set a spending
# limit at your AI provider.
LIVE_AI_DAILY_CAP=200

# Optional: Upstash Redis REST credentials, so the usage limits are shared
# across serverless instances. Without them, limits are per instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public URL, used for metadata and the sitemap
NEXT_PUBLIC_SITE_URL=https://surplus-ai.vercel.app
